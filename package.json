{
  "name": "foles-demo-web",
  "version": "0.0.0",
  "description": "Demonstração de FolEs no navegador de internet, usando LMHT.",
  "main": "index.html",
  "homepage": "https://designliquido.github.io/foles-demo-web",
  "scripts": {
    "copiar-arquivos": "yarn copy-files-from-to --force",
    "deploy": "gh-pages -d dist",
    "empacotar": "yarn del-cli ./dist && yarn gerar-web && yarn copiar-arquivos",
    "gerar-web": "yarn tsc && yarn browserify dist/index.js --s FolEs -o dist/foles.js",
    "predeploy": "echo 'Preparando deploy...'",
    "publicar": "yarn deploy",
    "servir": "yarn http-server -o ./dist -c-1",
    "testar": "yarn empacotar && yarn servir"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DesignLiquido/foles-demo-web.git"
  },
  "keywords": [
    "foles",
    "css",
    "português",
    "portuguese",
    "lmht",
    "html",
    "educação"
  ],
  "author": "Design Líquido",
  "license": "MIT",
  "dependencies": {
    "@designliquido/foles": "^0.15.1",
    "@designliquido/lmht-js": "^0.6.2"
  },
  "devDependencies": {
    "browserify": "^17.0.1",
    "del-cli": "^6.0.0",
    "http-server": "^14.1.1",
    "copy-files-from-to": "^3.13.0",
    "gh-pages": "^6.1.1",
    "typescript": "^5.9.3"
  },
  "copyFiles": [
    {
      "from": "index.html",
      "to": "dist/index.html"
    }
  ],
  "copyFilesSettings": {
    "whenFileExists": "overwrite"
  }
}
